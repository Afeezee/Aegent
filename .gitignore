# Dependencies
node_modules/

# Build output
dist/
build/
.vite/

# Runtime state — the server's SQLite DB lives here; NEVER commit it.
data/
server/data/

# Secrets (real .env files with keys should never leave the machine)
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript incremental cache
*.tsbuildinfo

# Android build outputs (the project source under web/android IS
# committed so anyone can build locally, but its build artefacts
# shouldn't bloat the repo).
web/android/.gradle/
web/android/build/
web/android/app/build/
web/android/local.properties
web/android/captures/
web/android/.idea/
*.apk
*.aab
*.keystore
!aegent-release.keystore.example

# Firebase service-account keys must never be committed — env var only.
*firebase-adminsdk*.json
aegent-*-firebase-*.json

# Secrets / local notes — never commit
ssh
ssh.pub
Aegent dep.txt
