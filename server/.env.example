PORT=8787
# 64+ random bytes in production. The server generates a dev-only default
# if unset, but that key is not a secret — set this before deploying.
JWT_SECRET=change-me

# ---- LLM agent (Groq) ----
# The per-chat agent calls Groq's OpenAI-compatible Chat Completions
# endpoint. Without a key the server returns 503 and the agent runs in
# offline mode. /healthz reports llm:true when GROQ_API_KEY is set.
# GROQ_API_KEY=
# Default model is GPT-OSS 120B on Groq — strongest tool-use model on
# the plan, closest in behaviour to Claude for the agent's confirm-card
# flow. Override to any id from GET /v1/models (e.g. qwen/qwen3.8-27b).
# GROQ_MODEL=openai/gpt-oss-120b
# Default base is https://api.groq.com/openai/v1 — only override if
# you're pointing at a Groq-compatible gateway.
# GROQ_API_BASE=

# ---- Web search (optional) ----
# Either one works. The agent's web_search tool is disabled if neither
# is set; /healthz reports webSearch:false in that case.
# SERPER_API_KEY=
# TAVILY_API_KEY=
# SEARCH_PROVIDER=serper   # optional: force a specific provider

# ---- PayPal (optional, required for agentic checkout) ----
# Create a Sandbox REST app at https://developer.paypal.com — grab its
# Client ID and Secret. The agent's checkout flow is disabled if either
# is unset; /healthz reports paypal:false in that case. PAYPAL_ENV
# selects sandbox vs live — leave at sandbox for the hackathon demo.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# Optional — the server derives these from the request origin when
# unset, which is almost always the right thing. Only set them if you
# need to pin a specific URL. NEVER point them at an /api/ path (the
# server refuses that and falls back to derivation).
# PAYPAL_RETURN_URL=
# PAYPAL_CANCEL_URL=

# ---- Paystack (optional, enables NGN/GHS/ZAR/KES + USD-via-Paystack) ----
# One key does the whole flow (hosted-checkout path). Get a test key
# at https://dashboard.paystack.com/#/settings/developers — starts with
# sk_test_... for test mode, sk_live_... for live. If both PayPal and
# Paystack are configured, the server picks per-currency: Paystack for
# NGN/GHS/ZAR/KES/USD (USD prefers Paystack when both are available);
# PayPal for everything else PayPal accepts.
# PAYSTACK_SECRET_KEY=
# Optional — same derivation rule as PAYPAL_RETURN_URL. Leave unset.
# PAYSTACK_CALLBACK_URL=
