PORT=8787
# 64+ random bytes in production. The server generates a dev-only default
# if unset, but that key is not a secret — set this before deploying.
JWT_SECRET=change-me

# ---- Web search (optional) ----
# Either one works. The agent's web_search tool is disabled if neither
# is set; /healthz reports webSearch:false in that case.
# SERPER_API_KEY=
# TAVILY_API_KEY=
# SEARCH_PROVIDER=serper   # optional: force a specific provider

# ---- PayPal (optional, required for agentic checkout) ----
# Create a Sandbox REST app at https://developer.paypal.com — grab its
# Client ID and Secret. The agent's checkout flow is disabled if either
# is unset; /healthz reports paypal:false in that case. PAYPAL_ENV
# selects sandbox vs live — leave at sandbox for the hackathon demo.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# PAYPAL_RETURN_URL=https://aegent.cereustechnologies.com/checkout/return
# PAYPAL_CANCEL_URL=https://aegent.cereustechnologies.com/checkout/cancel
